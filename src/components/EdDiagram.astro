---
interface Props {
  name:
    | 'coulomb-vectors'
    | 'gaussian-pillbox'
    | 'uniqueness-conductors'
    | 'method-of-images'
    | 'separation-slot'
    | 'multipole-geometry';
  caption?: string;
  alt?: string;
}

const { name, caption, alt } = Astro.props;
const label = alt ?? caption ?? name;
---
<figure class="physics-diagram-figure">
    <img
        src={`/diagrams/ed/${name}.svg`}
        alt={label}
        class="physics-diagram-img"
        loading="lazy"
    />
    {caption && <figcaption class="physics-diagram-caption">{caption}</figcaption>}
</figure>

<style is:global>
.physics-diagram-figure {
    margin: 20px auto;
    padding: 16px;
    max-width: 520px;
    background: var(--container-bg, #ffffff);
    border: 1px solid var(--border-color, #e2e8f0);
    border-radius: 10px;
    text-align: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

.physics-diagram-img {
    width: 100%;
    max-width: 480px;
    height: auto;
    display: block;
    margin: 0 auto;
}

body.dark-mode .physics-diagram-img {
    filter: invert(0.92) hue-rotate(180deg);
}

.physics-diagram-caption {
    margin-top: 10px;
    font-size: 0.9em;
    color: #64748b;
    font-style: italic;
}

body.dark-mode .physics-diagram-caption {
    color: #94a3b8;
}
</style>
