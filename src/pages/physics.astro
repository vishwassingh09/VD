---
import { getCollection, render } from 'astro:content';

const allEntries = (await getCollection('physics')).sort(
  (a, b) => a.data.order - b.data.order
);

const renderedByTab = new Map<string, Array<{ entry: (typeof allEntries)[number]; Content: any }>>();

for (const entry of allEntries) {
  const { Content } = await render(entry);
  const tab = entry.data.tab;
  if (!renderedByTab.has(tab)) {
    renderedByTab.set(tab, []);
  }
  renderedByTab.get(tab)!.push({ entry, Content });
}

interface SidebarGroup {
  name: string;
  items: Array<(typeof allEntries)[number]>;
}

function buildSidebar(tab: string) {
  const items = (renderedByTab.get(tab) ?? []).map((item) => item.entry);
  const intro = items.find((item) => item.data.isIntro);
  const groups: SidebarGroup[] = [];
  const groupMap = new Map<string, SidebarGroup>();

  for (const item of items) {
    if (item.data.isIntro) continue;
    const groupName = item.data.group ?? 'Topics';
    if (!groupMap.has(groupName)) {
      const group = { name: groupName, items: [] };
      groupMap.set(groupName, group);
      groups.push(group);
    }
    groupMap.get(groupName)!.items.push(item);
  }

  return { intro, groups };
}

const tabbedSections = [
  { tabKey: 'school', domId: 'school-physics' },
  { tabKey: 'college', domId: 'college-physics' },
  { tabKey: 'research', domId: 'research-physics' },
  { tabKey: 'exercises', domId: 'exercises' },
  { tabKey: 'notes', domId: 'msc-notes' },
] as const;

const introEntries = renderedByTab.get('introduction') ?? [];
---
<!DOCTYPE html>
<html lang="en">
    <head>
        <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9667197563513742" crossorigin="anonymous" is:inline></script>
        <meta name="google-adsense-account" content="ca-pub-9667197563513742">

        <script is:inline>
            MathJax = {
                tex: {
                    inlineMath: [['$', '$']],
                    displayMath: [['$$', '$$']],
                    packages: {'[+]': ['physics', 'ams']}
                },
                loader: {load: ['[tex]/physics']}
            };
        </script>
        <script type="text/javascript" id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-chtml.js" is:inline></script>

        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Physics | Vishwa Darpan</title>

        <link rel="stylesheet" href="/style.css">
    </head>

    <body>
        <header class="subject-header">
            <a href="/science" class="icon-btn" title="Back to Vigyan">⬅️</a>
            <h1>Physics</h1>
            <button class="icon-btn theme-toggle" onclick="toggleTheme()" title="Toggle Dark Mode">🌙</button>
        </header>

        <div class="container">
            <div class="tab-box">
                <button class="tab-btn active" onclick="openTab(event, 'introduction')">Introduction</button>
                <button class="tab-btn" onclick="openTab(event, 'school-physics')">School Physics</button>
                <button class="tab-btn" onclick="openTab(event, 'college-physics')">College Physics</button>
                <button class="tab-btn" onclick="openTab(event, 'research-physics')">Research Physics</button>
                <button class="tab-btn" onclick="openTab(event, 'exercises')">Exercises</button>
                <button class="tab-btn" onclick="openTab(event, 'msc-notes')">MSc Notes</button>
                <button class="tab-btn" onclick="openTab(event, 'genealogy')">Academic Lineage</button>
            </div>

            <section id="introduction" class="tab-content" style="display: block;">
                {introEntries.map(({ Content }) => <Content />)}
            </section>

            {tabbedSections.map(({ tabKey, domId }) => {
                const { intro, groups } = buildSidebar(tabKey);
                const entries = renderedByTab.get(tabKey) ?? [];
                return (
                    <section id={domId} class="tab-content">
                        <div class="school-layout-container">
                            <nav class="school-sidebar">
                                <ul>
                                    {intro && (
                                        <li>
                                            <a
                                                onclick={`showSchoolSection('${intro.data.sectionId}')`}
                                                style="font-weight: bold;"
                                            >
                                                {intro.data.sidebarLabel ?? intro.data.title}
                                            </a>
                                        </li>
                                    )}
                                    {groups.map((group) => (
                                        <>
                                            <li class="section-header">{group.name}</li>
                                            {group.items.map((item) => (
                                                <li>
                                                    <a
                                                        onclick={`showSchoolSection('${item.data.sectionId}')`}
                                                        style={item.data.highlight ? 'color: #007bff; font-weight: bold;' : undefined}
                                                    >
                                                        {item.data.sidebarLabel ?? item.data.title}
                                                    </a>
                                                </li>
                                            ))}
                                        </>
                                    ))}
                                </ul>
                            </nav>

                            <main class="school-main-content">
                                {entries.map(({ entry, Content }) => (
                                    <div
                                        id={entry.data.sectionId}
                                        class={`school-note-section${entry.data.isIntro ? ' active-school-section' : ''}`}
                                    >
                                        <Content />
                                    </div>
                                ))}
                            </main>
                        </div>
                    </section>
                );
            })}

            <section id="genealogy" class="tab-content">
                <div class="school-layout-container" style="display: block; padding: 0;">
                    <div style="position: absolute; z-index: 10; padding: 20px; pointer-events: none;">
                        <h2 style="color: #fff; margin: 0; text-shadow: 0 0 10px rgba(255,255,255,0.5);">The Physics Network</h2>
                        <p style="color: #aaa; margin-top: 5px;">Left-Click & Drag to Rotate | Scroll to Zoom | Click a Node to Fly</p>
                    </div>
                    <div id="3d-graph" style="width: 100%; height: 800px; background-color: #000005; border-radius: 8px; overflow: hidden;"></div>
                </div>
            </section>

            <style>
                .node-tooltip {
                    background: rgba(10, 20, 40, 0.85);
                    border: 1px solid #00d2ff;
                    box-shadow: 0 0 15px rgba(0, 210, 255, 0.4);
                    border-radius: 8px;
                    padding: 15px;
                    color: #fff;
                    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                    max-width: 300px;
                    backdrop-filter: blur(4px);
                }
                .node-tooltip h3 {
                    margin: 0 0 5px 0;
                    color: #00d2ff;
                    font-size: 1.2em;
                    text-transform: uppercase;
                    letter-spacing: 1px;
                }
                .node-tooltip .legacy {
                    color: #ffaa00;
                    font-size: 0.9em;
                    font-weight: bold;
                    margin-bottom: 10px;
                    display: block;
                }
                .node-tooltip p {
                    margin: 0;
                    font-size: 0.85em;
                    line-height: 1.5;
                    color: #ddd;
                    white-space: normal;
                }
            </style>
        </div>

        <script src="https://unpkg.com/3d-force-graph" is:inline></script>

        <script is:inline>
            document.addEventListener("DOMContentLoaded", function() {
                const gData = {
                    nodes: [
                        { id: 'Sterman', name: 'George Sterman', group: 1, val: 5, role: 'PhD Advisor (Stony Brook)', desc: 'Pioneered perturbative Quantum Chromodynamics (QCD) and the theory of strong interactions.' },
                        { id: 'Raychaudhuri', name: 'Amal Kumar Raychaudhuri', group: 1, val: 6, role: 'Undergrad Mentor', desc: 'Renowned for the Raychaudhuri Equation, a fundamental result in General Relativity.' },
                        { id: 'Sen', name: 'Ashoke Sen', group: 2, val: 10, role: 'Theoretical Physicist', desc: 'Revolutionized String Theory. Discovered S-Duality. Pioneered the entropy function formalism for extremal black holes.' },
                        { id: 'Maldacena', name: 'Juan Maldacena', group: 2, val: 10, role: 'String Theorist', desc: 'Authored the AdS/CFT Correspondence, linking quantum gravity to conformal field theories.' },
                        { id: 'Hubbard', name: 'John Hubbard', group: 3, val: 8, role: 'Condensed Matter Pioneer', desc: 'Formulated the Hubbard Model in 1963 to describe electron correlations and metal-insulator transitions in narrow energy bands.' },
                        { id: 'Sachdev', name: 'Subir Sachdev', group: 4, val: 8, role: 'Condensed Matter Physicist', desc: 'Extended the study of quantum phase transitions. Co-creator of the SYK model.' },
                        { id: 'Ye', name: 'Jinwu Ye', group: 4, val: 5, role: 'Theoretical Physicist', desc: 'Co-developed the Sachdev-Ye model for quantum magnets with random exchange interactions.' },
                        { id: 'Kitaev', name: 'Alexei Kitaev', group: 4, val: 9, role: 'Quantum Computer Scientist', desc: 'Proposed the Majorana fermion quantum computer and generalized the SYK model to study black hole chaos.' }
                    ],
                    links: [
                        { source: 'Sterman', target: 'Sen', name: 'Advised' },
                        { source: 'Raychaudhuri', target: 'Sen', name: 'Mentored' },
                        { source: 'Maldacena', target: 'Sen', name: 'String Theory Collaboration' },
                        { source: 'Hubbard', target: 'Sachdev', name: 'Theoretical Foundation' },
                        { source: 'Sachdev', target: 'Ye', name: 'Co-authored SY Model' },
                        { source: 'Kitaev', target: 'Sachdev', name: 'Extended to SYK Model' },
                        { source: 'Sachdev', target: 'Maldacena', name: 'Holographic Connections (AdS/CFT)' }
                    ]
                };

                const elem = document.getElementById('3d-graph');
                if (!elem || typeof ForceGraph3D === 'undefined') return;

                const Graph = ForceGraph3D()(elem)
                    .graphData(gData)
                    .nodeAutoColorBy('group')
                    .nodeVal('val')
                    .linkWidth(2)
                    .linkOpacity(0.5)
                    .linkColor(() => '#00d2ff')
                    .nodeLabel(node => `
                        <div class="node-tooltip">
                            <h3>${node.name}</h3>
                            <span class="legacy">${node.role}</span>
                            <p>${node.desc}</p>
                        </div>
                    `)
                    .onNodeClick(node => {
                        const distance = 40;
                        const distRatio = 1 + distance / Math.hypot(node.x, node.y, node.z);
                        Graph.cameraPosition(
                            { x: node.x * distRatio, y: node.y * distRatio, z: node.z * distRatio },
                            node,
                            2000
                        );
                    });

                let angle = 0;
                setInterval(() => {
                    Graph.cameraPosition({
                        x: 150 * Math.sin(angle),
                        z: 150 * Math.cos(angle)
                    });
                    angle += Math.PI / 1000;
                }, 30);

                document.querySelectorAll('.tab-btn').forEach(btn => {
                    btn.addEventListener('click', () => {
                        setTimeout(() => {
                            Graph.width(elem.clientWidth);
                            Graph.height(elem.clientHeight);
                        }, 50);
                    });
                });
            });
        </script>

        <script is:inline>
        function activateTabByName(sectionName) {
            var tabcontent = document.getElementsByClassName("tab-content");
            for (var i = 0; i < tabcontent.length; i++) {
                tabcontent[i].style.display = "none";
            }

            var tablinks = document.getElementsByClassName("tab-btn");
            for (var i = 0; i < tablinks.length; i++) {
                tablinks[i].classList.remove("active");
            }

            var targetContent = document.getElementById(sectionName);
            if (targetContent) {
                targetContent.style.display = "block";
                var targetBtn = document.querySelector(`.tab-btn[onclick*="'${sectionName}'"]`);
                if (targetBtn) {
                    targetBtn.classList.add("active");
                }

                var activeSub = targetContent.querySelector('.active-school-section');
                if (!activeSub) {
                    var defaultSub = targetContent.querySelector('.school-note-section');
                    if (defaultSub) {
                        defaultSub.classList.add('active-school-section');
                    }
                }
            }
        }

        function openTab(evt, sectionName) {
            activateTabByName(sectionName);
            if (history.replaceState) {
                history.replaceState(null, '', '#' + sectionName);
            }
        }

        function handleHashRouting() {
            var hash = window.location.hash.replace('#', '');
            if (!hash) return;
            var targetEl = document.getElementById(hash);
            if (!targetEl) return;

            if (targetEl.classList.contains('tab-content')) {
                activateTabByName(hash);
            } else if (targetEl.classList.contains('school-note-section')) {
                var parentTab = targetEl.closest('.tab-content');
                if (parentTab) {
                    activateTabByName(parentTab.id);
                }
                showSchoolSection(hash, false);
            }
        }

        window.addEventListener('DOMContentLoaded', handleHashRouting);
        window.addEventListener('hashchange', handleHashRouting);

        function showSchoolSection(sectionId, updateHash = true) {
            var sections = document.getElementsByClassName("school-note-section");
            for (var i = 0; i < sections.length; i++) {
                sections[i].classList.remove("active-school-section");
            }
            var target = document.getElementById(sectionId);
            if (target) {
                target.classList.add("active-school-section");
            }
            if (updateHash && history.replaceState) {
                history.replaceState(null, '', '#' + sectionId);
            }
        }

        function toggleTheme() {
            document.body.classList.toggle("dark-mode");
        }
        </script>
    </body>
</html>
