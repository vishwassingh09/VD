        <script is:inline>
            // 1. Set the Date in Marathi
            const now = new Date();
            const options = { weekday: 'short', month: 'short', day: 'numeric' };
            const dateStr = now.toLocaleDateString('mr-IN', options);

            // 2. Find the top bar element and set a loading message
            const infoBox = document.getElementById('date-temp');
            infoBox.innerText = `${dateStr} | हवामान लोड करत आहे...`; 

            // 3. Fetch live weather data for Pune 
            fetch('https://api.open-meteo.com/v1/forecast?latitude=18.5204&longitude=73.8567&current_weather=true')
                .then(response => response.json())
                .then(data => {
                    const currentTemp = Math.round(data.current_weather.temperature);
                    infoBox.innerText = `${dateStr} | पुणे: ${currentTemp}°C`;
                })
                .catch(error => {
                    infoBox.innerText = `${dateStr} | पुणे: --°C`;
                    console.error("Could not load weather data:", error);
                });
        </script>
